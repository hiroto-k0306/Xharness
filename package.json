{
  "name": "xharness",
  "version": "0.0.0",
  "private": true,
  "description": "XHarness Windows coding agent",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "test": "vitest run --exclude=spike/.out/** --exclude=.tools/** --exclude=dist/**",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "report:demo": "tsx scripts/report-demo.ts",
    "headless": "tsx src/headless.ts",
    "build:headless": "tsc --noEmit false --rootDir src --outDir dist --incremental false --project tsconfig.headless.json",
    "spike:claude:creds": "tsx spike/claude/c1-creds.ts",
    "spike:claude:text": "tsx spike/claude/c2-text.ts",
    "spike:claude:tool": "tsx spike/claude/c3-tool.ts",
    "spike:claude:usage": "tsx spike/claude/c4-usage.ts",
    "spike:claude:abort": "tsx spike/claude/r2-abort.ts",
    "spike:codex:creds": "tsx spike/codex/x1-creds.ts",
    "spike:codex:text": "tsx spike/codex/x2-text.ts",
    "spike:codex:tool": "tsx spike/codex/x3-tool.ts",
    "spike:codex:effort": "tsx spike/codex/x4-effort.ts",
    "spike:codex:models": "tsx spike/codex/x5-models.ts",
    "spike:codex:usage": "tsx spike/codex/x6-usage.ts",
    "spike:codex:abort": "tsx spike/codex/r2-abort.ts",
    "spike:codex:encrypted-replay": "tsx spike/codex/x3-encrypted-replay.ts",
    "spike:cli:refresh": "tsx spike/cli-refresh.ts",
    "spike:claude:thinking-binding": "tsx spike/claude/thinking-binding.ts",
    "dev": "electron-vite dev",
    "dev:fake": "electron-vite dev -- --fake",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "icon": "tsx scripts/make-icon.ts",
    "package": "pnpm icon && pnpm build && electron-builder --win",
    "package:dir": "pnpm icon && pnpm build && electron-builder --win --dir",
    "release:collect": "tsx scripts/collect-release.ts",
    "release": "pnpm package && pnpm release:collect"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "packageManager": "pnpm@10.34.6",
  "main": "out/main/index.js",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "turndown": "^7.2.4",
    "undici": "^7.30.0"
  }
}
